# React Native's dependency graph routinely declares peer ranges that npm 7+
# refuses to reconcile — Reanimated, Skia and VisionCamera all peer on exact
# react-native versions. Left alone, `npm install` aborts with ERESOLVE and
# creates no node_modules at all.
#
# That failure is quiet in the worst way: the next command walks up past the
# repository and resolves the Expo CLI out of the user's HOME directory, and
# every error afterwards names paths that have nothing to do with this project.
#
# `npx expo install --check` is the real authority on version compatibility here,
# not npm's peer solver.
legacy-peer-deps=true
