{
  "name": "elongo-mobile",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/**/*.test.ts\"",
    "correspondent": "npm run start --workspace @elongo/correspondent",
    "viewer": "npm run start --workspace @elongo/viewer",
    "doctor": "node scripts/doctor.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "ios": "npm run ios --workspace @elongo/viewer",
    "android": "npm run android --workspace @elongo/correspondent"
  }
}
