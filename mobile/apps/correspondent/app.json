{
  "expo": {
    "name": "Elongo Correspondant",
    "slug": "elongo-correspondent",
    "scheme": "elongo-corr",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": [
      "android"
    ],
    "android": {
      "package": "cd.elongo.correspondent",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#0B1620"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Elongo utilise la caméra pour filmer l'événement que vous couvrez.",
          "enableMicrophonePermission": true,
          "microphonePermissionText": "Elongo utilise le micro pour que la famille entende la cérémonie."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
